/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY
  Permissions-Policy: microphone=(), camera=(), geolocation=(), midi=(self), speaker-selection=(self)
/sw.js
  Cache-Control: no-cache
/netlify-client.js
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache, must-revalidate
/app.js
  Cache-Control: no-cache, must-revalidate
/data.js
  Cache-Control: no-cache, must-revalidate

/.netlify/functions/loops-session
  Cache-Control: private, no-store

/midi.js
  Cache-Control: no-cache, must-revalidate

/audio-output.js
  Cache-Control: no-cache, must-revalidate
/access-mode.js
  Cache-Control: no-cache, must-revalidate
